}
local Saved={}

local function save(o,p)
 if not o then return end
 Saved[o]=Saved[o] or {}
 if Saved[o][p]==nil then
  local ok,v=pcall(function() return o[p] end)
  if ok then Saved[o][p]=v end
 end
end

local function set(o,p,v)
 save(o,p)
 pcall(function() o[p]=v end)
end

local function restore()
 for o,t in pairs(Saved) do
  if o and o.Parent then
   for p,v in pairs(t) do
    pcall(function() o[p]=v end)
   end
  end
 end
 table.clear(Saved)
end

local function has(n,list)
 n=string.lower(tostring(n or ""))
 for _,w in ipairs(list) do
  if string.find(n,string.lower(w),1,true) then
   return true
  end
 end
 return false
end

