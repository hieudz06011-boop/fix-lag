local Protect={"island","map","world","mainland","terrain","ocean","sea","water","spawn","lobby"}

local function localChar(o)
 return Player.Character and o:IsDescendantOf(Player.Character) or false
end

local function isPet(o)
 local x=o
 for _=1,8 do
  if not x then break end
  if has(x.Name,Pets) then return true end
  x=x.Parent
 end
 return false
end

local function otherChar(o)
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=Player and p.Character and o:IsDescendantOf(p.Character) then
   return not isPet(o)
  end
 end
 return false
end

local function protected(o)
 if o:IsA("Terrain") or o:IsA("Camera") or localChar(o) then return true end
 local x=o
 while x.Parent and x.Parent~=Workspace do
  x=x.Parent
 end
 return has(x.Name,Protect)
end

local function hide(o)
 if o:IsA("BasePart") then
  set(o,"LocalTransparencyModifier",1)
  set(o,"CastShadow",false)
 elseif o:IsA("Decal") or o:IsA("Texture") then
  set(o,"Transparency",1)
 elseif o:IsA("ParticleEmitter") then
  set(o,"Enabled",false)
  pcall(function() o:Clear() end)
  set(o,"LocalTransparencyModifier",1)
 elseif o:IsA("Beam") or o:IsA("Trail") then
  set(o,"Enabled",false)
  set(o,"LocalTransparencyModifier",1)
 elseif o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Highlight") then
  set(o,"Enabled",false)
 elseif o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
  set(o,"Enabled",false)
 end
end

local function hideModel(o)
 hide(o)
 for _,x in ipairs(o:GetDescendants()) do
  hide(x)
 end
end

local function process(o)
 if localChar(o) then return end

 if C.DisableVFX then
  if o:IsA("ParticleEmitter") then
   set(o,"Enabled",false)
   pcall(function() o:Clear() end)
   set(o,"LocalTransparencyModifier",1)
  elseif o:IsA("Beam") or o:IsA("Trail") then
   set(o,"Enabled",false)
   set(o,"LocalTransparencyModifier",1)
  elseif o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Highlight") then
   set(o,"Enabled",false)
  elseif o:IsA("PointLight") or o:IsA("SpotLight") or o:IsA("SurfaceLight") then
   set(o,"Enabled",false)
  end
 end

 if C.PetEffects and (isPet(o) or has(o.Name,PetFX)) and
  (o:IsA("ParticleEmitter") or o:IsA("Beam") or o:IsA("Trail") or
   o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Highlight")) then
  hide(o)
 end

 if C.HidePlants and has(o.Name,Plants) then hide(o);return end
 if C.HideFruits and has(o.Name,Fruits) then hide(o);return end
 if C.HidePets and isPet(o) then hide(o);return end
 if C.HideOtherPlayers and otherChar(o) then hide(o);return end
 if C.HideDecorations and has(o.Name,Decor) then hideModel(o);return end

 if C.HideEverything and not protected(o) and not isPet(o) then
  if o:IsA("BasePart") or o:IsA("Decal") or o:IsA("Texture") or
     o:IsA("ParticleEmitter") or o:IsA("Beam") or o:IsA("Trail") or
     o:IsA("Fire") or o:IsA("Smoke") or o:IsA("Sparkles") or o:IsA("Highlight") then
   hide(o)
  end
 end
end

local scanning=false
local function scan()
 if scanning then return end
 scanning=true
 task.spawn(function()
  for i,o in ipairs(Workspace:GetDescendants()) do
   pcall(process,o)
   if i%150==0 then task.wait() end
  end
  scanning=false
 end)
end

local oldQuality
pcall(function() oldQuality=settings().Rendering.QualityLevel end)
local oldShadows=Lighting.GlobalShadows

local function graphics()
 if C.LowGraphics then
  pcall(function() settings().Rendering.QualityLevel=Enum.QualityLevel.Level01 end)
 elseif oldQuality then
  pcall(function() settings().Rendering.QualityLevel=oldQuality end)
 end
end

local function shadows()
 if C.DisableShadows then
  set(Lighting,"GlobalShadows",false)
  task.spawn(function()
   for i,o in ipairs(Workspace:GetDescendants()) do
    if o:IsA("BasePart") then set(o,"CastShadow",false) end
    if i%200==0 then task.wait() end
   end
  end)
 end
end

local function post()
 for _,o in ipairs(Lighting:GetDescendants()) do
  if o:IsA("PostEffect") then
   set(o,"Enabled",not C.DisablePost)
  elseif o:IsA("Clouds") then
   set(o,"Enabled",not C.DisablePost)
  end
 end
end

local function optimize()
 graphics()
 if C.DisableShadows then shadows() end
 post()
 scan()
end

