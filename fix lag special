-- FPS / RAM / Ping
local frames,last=0,os.clock()

RunService.RenderStepped:Connect(function()
 frames+=1
 local n=os.clock()

 if n-last>=1 then
  local fps=frames/(n-last)
  frames=0
  last=n

  FL.Text=string.format("FPS: %.0f",fps)
  CL.Text="CPU: "..(
   fps>=55 and "Low" or
   fps>=35 and "Medium" or
   fps>=20 and "High" or
   "Very High"
  ).." (estimate)"
 end
end)

task.spawn(function()
 while G.Parent do
  task.wait(1)

  pcall(function()
   RL.Text=string.format("RAM: %.0f MB",Stats:GetTotalMemoryUsageMb())
  end)

  pcall(function()
   PL.Text=string.format(
    "Ping: %.0f ms",
    Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
   )
  end)
 end
end)

